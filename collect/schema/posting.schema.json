{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RealRole posting row",
  "description": "One posting seen on a company's ATS board (postings_<date>.jsonl). Contract 2.4.",
  "type": "object",
  "required": [
    "posting_id",
    "ticker",
    "ats",
    "ats_job_id",
    "title",
    "location",
    "state",
    "country",
    "posted_date",
    "salary_min",
    "salary_max",
    "salary_listed",
    "description",
    "first_seen",
    "last_seen",
    "snapshots",
    "repost_of",
    "soc_code",
    "job_zone"
  ],
  "properties": {
    "posting_id": {
      "type": "string"
    },
    "ticker": {
      "type": "string"
    },
    "ats": {
      "enum": [
        "greenhouse",
        "lever",
        "workday"
      ]
    },
    "ats_job_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string"
    },
    "location": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "type": [
        "string",
        "null"
      ]
    },
    "country": {
      "type": [
        "string",
        "null"
      ]
    },
    "posted_date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "salary_min": {
      "type": [
        "number",
        "null"
      ],
      "description": "annual USD"
    },
    "salary_max": {
      "type": [
        "number",
        "null"
      ]
    },
    "salary_listed": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "null when the description wasn't fetched"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "first_seen": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "last_seen": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "snapshots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repost_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "soc_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "job_zone": {
      "type": [
        "integer",
        "null"
      ]
    }
  }
}